# ==============================================================================
# .env.example — Verifyyy eKYC Platform Environment Configuration
# Copy this file to .env and populate with real values.
# NEVER commit .env to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Project URL from: Supabase Dashboard > Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (safe for browser, used with RLS)
# From: Supabase Dashboard > Settings > API > Project API keys > anon public
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Supabase service_role key (server-side only — NEVER expose to browser)
# From: Supabase Dashboard > Settings > API > Project API keys > service_role
# Required for: token revocation persistence, server-side upserts bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Default verifications table name
SUPABASE_TABLE=verifications

# ------------------------------------------------------------------------------
# Application Secrets — REQUIRED at startup (min 32 hex characters / 128 bits)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
# Signs applicant session tokens. Rotate immediately if compromised.
APPLICANT_SESSION_SECRET=replace-with-at-least-64-hex-characters-of-random-data

# Signs temporary asset download URLs. Rotate immediately if compromised.
ASSET_SIGNING_SECRET=replace-with-at-least-64-hex-characters-of-random-data

# ------------------------------------------------------------------------------
# CORS / Network Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
# Add your production domain here; remove localhost entries for production.
ALLOWED_CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:5174,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# Token Revocation Backend
# ------------------------------------------------------------------------------
# "memory"   — single-instance, revocations lost on restart (development only)
# "supabase" — durable, shared across restarts/instances (production required)
# SUPABASE_SERVICE_ROLE_KEY must be set when using "supabase"
REVOCATION_BACKEND=memory

# ------------------------------------------------------------------------------
# Expo / React Native Client Variables (safe to expose in mobile bundle)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
