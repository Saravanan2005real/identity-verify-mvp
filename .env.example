# ==============================================================================
# .env.example — Verifyyy eKYC Platform Master Environment Configuration
# Copy this file to .env and populate with real values.
# NEVER commit .env to source control.
# Individual service examples: products/ocr_engine/.env.example,
# superadmin/backend/.env.example, admin/frontend/.env.example, superadmin/frontend/.env.example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence Layer
# ------------------------------------------------------------------------------
# PostgreSQL database URI (required for Superadmin in production; SQLite fallback is disallowed in prod)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Default verifications table name
SUPABASE_TABLE=verifications

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Authentication & Verification Records)
# ------------------------------------------------------------------------------
# Project URL from: Supabase Dashboard > Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (safe for browser, used with RLS)
# From: Supabase Dashboard > Settings > API > Project API keys > anon public
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Supabase service_role key (server-side only — NEVER expose to browser)
# From: Supabase Dashboard > Settings > API > Project API keys > service_role
# Required for: token revocation persistence, server-side upserts bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Application Cryptographic Secrets (min 32 hex characters / 128 bits)
# Both OCR engine and Superadmin backend validate these at startup and fail-closed if missing, weak, or placeholder.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
# Signs applicant session tokens. Rotate immediately if compromised.
APPLICANT_SESSION_SECRET=replace-with-at-least-64-hex-characters-of-random-data

# Signs temporary asset download URLs in OCR engine. Rotate immediately if compromised.
ASSET_SIGNING_SECRET=replace-with-at-least-64-hex-characters-of-random-data

# ------------------------------------------------------------------------------
# 4. Environment, Fallback, & CORS Configuration
# ------------------------------------------------------------------------------
# Runtime environment: "development" or "production"
APP_ENV=development

# Disallows silent local fallbacks (SQLite / in-memory tokens) when in production
ALLOW_LOCAL_FALLBACK=true

# Storage backend for token revocation ("memory" in dev, "supabase" in production)
REVOCATION_BACKEND=memory

# Comma-separated list of allowed frontend origins (must use HTTPS, no wildcard/localhost in production)
ALLOWED_CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:5174,http://127.0.0.1:8081,http://127.0.0.1:8082,http://127.0.0.1:5174

# Listening port for Flask OCR Engine (defaults to 5001)
PORT=5001

# ------------------------------------------------------------------------------
# 5. Superadmin Allowlist & Access Control
# ------------------------------------------------------------------------------
# Comma-separated allowed corporate domains (e.g. yourcompany.com)
ALLOWED_SUPERADMIN_DOMAINS=

# Comma-separated allowed superadmin email addresses
ALLOWED_SUPERADMIN_EMAILS=

# ------------------------------------------------------------------------------
# 6. Expo / React Native Client Variables (baked into client bundles at build time)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# API Base URLs for Frontends (required in build/production; no localhost fallback in prod)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5001
EXPO_PUBLIC_SUPERADMIN_API_URL=http://127.0.0.1:8000

# Superadmin frontend corporate domain policy (must match ALLOWED_SUPERADMIN_DOMAINS if set)
EXPO_PUBLIC_SUPERADMIN_ALLOWED_DOMAINS=
