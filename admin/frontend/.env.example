# ==============================================================================
# .env.example — Client Admin Portal (React Native Web Port 8082)
# ==============================================================================

# Purpose: Supabase project REST URL for client authentication and audit queries
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Purpose: Supabase public publishable/anon key for client-side RLS queries
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Purpose: Alternative Supabase anon key alias
# Classification: Public (baked into client bundle by Expo)
# Required in Production: NO (fallback if publishable key is not set)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Purpose: Base URL for backend AI OCR and Biometrics API (no localhost default in production)
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_API_BASE_URL=https://api.yourdomain.com

# Purpose: Base URL for applicant verification web flow (verify.html)
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_VERIFY_BASE_URL=https://verify.yourdomain.com

# Purpose: Tenant Admin Portal URL
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_ADMIN_PORTAL_URL=https://admin.yourdomain.com

# Purpose: Superadmin Management Portal URL
# Classification: Public (baked into client bundle by Expo)
# Required in Production: NO
EXPO_PUBLIC_SUPERADMIN_PORTAL_URL=https://superadmin.yourdomain.com

