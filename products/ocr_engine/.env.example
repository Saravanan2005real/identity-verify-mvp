# ==============================================================================
# .env.example — OCR Engine (Flask Port 5001)
# ==============================================================================

# Purpose: Supabase project REST API endpoint
# Classification: Config
# Required in Production: YES
SUPABASE_URL=https://your-project-ref.supabase.co

# Purpose: Supabase public anon/publishable key for RLS operations
# Classification: Public
# Required in Production: YES
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Purpose: Supabase service role secret key (bypasses RLS for server-side operations)
# Classification: Secret
# Required in Production: YES
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Purpose: Database table storing verification sessions
# Classification: Config
# Required in Production: NO (defaults to 'verifications')
SUPABASE_TABLE=verifications

# Purpose: Cryptographic HMAC-SHA256 secret for signing and verifying applicant session tokens
# Classification: Secret (min 32 hex chars / 128-bit)
# Required in Production: YES
APPLICANT_SESSION_SECRET=replace-with-at-least-64-hex-characters-of-random-data

# Purpose: Cryptographic HMAC-SHA256 secret for generating temporary signed asset URLs
# Classification: Secret (min 32 hex chars / 128-bit)
# Required in Production: YES
ASSET_SIGNING_SECRET=replace-with-at-least-64-hex-characters-of-random-data

# Purpose: Comma-separated list of allowed frontend origins (must be HTTPS in prod, no wildcard or localhost)
# Classification: Config
# Required in Production: YES
ALLOWED_CORS_ORIGINS=https://admin.yourdomain.com,https://superadmin.yourdomain.com,https://verify.yourdomain.com

# Purpose: Storage backend for token revocation ('memory' for single-node dev, 'supabase' for durable multi-node)
# Classification: Config
# Required in Production: YES (must be 'supabase')
REVOCATION_BACKEND=memory

# Purpose: Runtime environment indicator ('development' or 'production')
# Classification: Config
# Required in Production: YES (must be 'production' to enforce security controls)
APP_ENV=development

# Purpose: Disallows fallback to in-memory registries or local files in production
# Classification: Config
# Required in Production: YES (must be 'false' in production)
ALLOW_LOCAL_FALLBACK=true

# Purpose: Local HTTP listening port for Flask service
# Classification: Config
# Required in Production: NO (defaults to 5001)
PORT=5001

# Purpose: Data retention cutoff in hours for temporary asset uploads in UPLOAD_FOLDER
# Classification: Config
# Required in Production: NO (defaults to 24)
RETENTION_HOURS=24

# Purpose: Web verification interface URL (for cross-service CORS and redirects)
EXPO_PUBLIC_VERIFY_BASE_URL=https://verify.yourdomain.com

# Purpose: Admin and Superadmin portal URLs
ADMIN_PORTAL_URL=https://admin.yourdomain.com
SUPERADMIN_PORTAL_URL=https://superadmin.yourdomain.com

