# ==============================================================================
# .env.example — Superadmin Backend API (FastAPI Port 8000)
# ==============================================================================

# Purpose: PostgreSQL connection URI (SQLite fallback 'sqlite:///./superadmin.db' is blocked in production)
# Classification: Secret / Config
# Required in Production: YES
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Purpose: Supabase project REST API endpoint for token authentication
# Classification: Config
# Required in Production: YES
SUPABASE_URL=https://your-project-ref.supabase.co

# Purpose: Supabase public anon/publishable key
# Classification: Public
# Required in Production: YES
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Purpose: Supabase service role secret key
# Classification: Secret
# Required in Production: YES
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Purpose: Cryptographic HMAC-SHA256 secret for validating applicant session tokens
# Classification: Secret (min 32 hex chars / 128-bit)
# Required in Production: YES
APPLICANT_SESSION_SECRET=replace-with-at-least-64-hex-characters-of-random-data

# Purpose: Comma-separated list of allowed frontend origins (must be HTTPS in prod)
# Classification: Config
# Required in Production: YES
ALLOWED_CORS_ORIGINS=https://superadmin.yourdomain.com,https://admin.yourdomain.com

# Purpose: Storage backend for token revocation ('memory' or 'supabase')
# Classification: Config
# Required in Production: YES (must be 'supabase')
REVOCATION_BACKEND=memory

# Purpose: Runtime environment indicator ('development' or 'production')
# Classification: Config
# Required in Production: YES (must be 'production')
APP_ENV=development

# Purpose: Disallows fallback to SQLite or local memory in production
# Classification: Config
# Required in Production: YES (must be 'false' in production)
ALLOW_LOCAL_FALLBACK=true

# Purpose: Comma-separated list of corporate domains permitted for superadmin role (empty allows any authenticated user)
# Classification: Config
# Required in Production: NO
ALLOWED_SUPERADMIN_DOMAINS=yourcompany.com

# Purpose: Comma-separated list of individual email addresses permitted for superadmin role
# Classification: Config
# Required in Production: NO
ALLOWED_SUPERADMIN_EMAILS=admin@yourcompany.com,ops@yourcompany.com

