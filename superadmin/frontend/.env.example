# ==============================================================================
# .env.example — Superadmin Platform (React Native Web Port 8081)
# ==============================================================================

# Purpose: Supabase project REST URL for superadmin authentication
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Purpose: Supabase public publishable/anon key
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Purpose: Alternative Supabase anon key alias
# Classification: Public (baked into client bundle by Expo)
# Required in Production: NO (fallback if publishable key is not set)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Purpose: Base URL for Superadmin Backend API (no localhost default in production)
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_SUPERADMIN_API_URL=https://superadmin-api.yourdomain.com

# Purpose: Base URL for applicant verification web flow (verify.html)
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_VERIFY_BASE_URL=https://verify.yourdomain.com

# Purpose: URL for Tenant Admin Portal (used in dashboard links)
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_ADMIN_PORTAL_URL=https://admin.yourdomain.com

# Purpose: URL for Superadmin Management Portal (used in invitation messages)
# Classification: Public (baked into client bundle by Expo)
# Required in Production: YES
EXPO_PUBLIC_SUPERADMIN_PORTAL_URL=https://superadmin.yourdomain.com

# Purpose: Corporate domain restriction for superadmin login (empty permits any authenticated user)
# Classification: Public (baked into client bundle by Expo)
# Required in Production: NO
EXPO_PUBLIC_SUPERADMIN_ALLOWED_DOMAINS=yourcompany.com

